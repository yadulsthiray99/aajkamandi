{
  // Static site only: Cloudflare serves dist/ as static assets (no Worker script runs,
  // so requests are not counted against the Workers request limits).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aajkamandi",
  "compatibility_date": "2026-10-12",
  // Custom domains: Cloudflare creates the DNS records and SSL certificates on deploy.
  "routes": [
    { "pattern": "aajkamandi.com", "custom_domain": true },
    { "pattern": "www.aajkamandi.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
