{
  // Static site served from dist/; a small Worker (worker/index.js) only handles POST /api/contact.
  // so requests are not counted against the Workers request limits).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aajkamandi",
  "compatibility_date": "2026-10-12",
  "main": "worker/index.js",
  "send_email": [{ "name": "MAIL" }],
  // Custom domains: Cloudflare creates the DNS records and SSL certificates on deploy.
  "routes": [
    { "pattern": "aajkamandi.com", "custom_domain": true },
    { "pattern": "www.aajkamandi.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
